{
    "name": "nickture/ai-native-laravel",
    "description": "Excerpt of Overy's composer.json: the packages Laravel Boost reads to choose guidelines and skills, and the hook that rebuilds CLAUDE.md on every composer update.",
    "require": {
        "php": "^8.5",
        "ext-imagick": "*",
        "filament/filament": "^5.9.0",
        "inertiajs/inertia-laravel": "^3.5.1",
        "intervention/image": "^4.3.3",
        "laravel/fortify": "^1.40.0",
        "laravel/framework": "^13.34.0",
        "laravel/mcp": "^0.9.6",
        "laravel/octane": "^2.20.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.21",
        "league/commonmark": "^2.10.3",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "nativephp/desktop": "^2.3.1",
        "phpoffice/phpspreadsheet": "^5.10",
        "phpoffice/phpword": "^1.4",
        "smalot/pdfparser": "^2.12.5",
        "socialiteproviders/apple": "^5.12",
        "socialiteproviders/telegram": "^4.1.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4.4",
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24.1",
        "laramint/laravel-brain": "^2.7.1",
        "larastan/larastan": "^3.12.2",
        "laravel/boost": "^2.10.1",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.68",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^13.3.6",
        "rector/rector": "^2.6.7"
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi",
            "@php artisan app:native-install --ansi"
        ]
    }
}
